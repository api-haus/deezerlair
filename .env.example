# Copy to .env, then chmod 600 .env — .env is ignored by git.
# Register an application at https://developers.deezer.com/myapps
#
# The redirect URL must be identical in the application form and here.
# Deezer allows exactly one redirect URL per application.

DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_REDIRECT_URI=http://localhost:8080/deezerlair

# Optional. Set this to bypass state/token.json — useful in a container or a
# scheduled job. The login flow writes the token file instead.
# DEEZER_ACCESS_TOKEN=
